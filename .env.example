# Dropbox credentials for scripts/dropbox_sync.py
# Copy to .env (git-ignored) and fill in. Create an app at
# https://www.dropbox.com/developers/apps with files.content.read and, if you
# use --archive, files.content.write scopes.

# --- Recommended: long-lived refresh-token app auth ---
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# --- OR a single access token (simpler; may be short-lived) ---
# DROPBOX_ACCESS_TOKEN=

# Password for encrypted PDF statements (optional). If unset, ingest_pdf.py
# prompts securely when it hits a locked PDF. Setting it here avoids re-typing.
# PFA_PDF_PASSWORD=

# Anthropic API key — only needed for `ingest_pdf.py --ai` (opt-in text
# structuring). The default PDF parser and everything else work without it.
# ANTHROPIC_API_KEY=
